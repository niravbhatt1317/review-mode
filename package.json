{
  "name": "review-mode",
  "version": "2.0.46",
  "description": "Design review comments on any page, shared on a team hub. The browser extension and the shared rules.",
  "type": "module",
  "license": "MIT",
  "repository": "github:niravbhatt1317/review-mode",
  "exports": {
    "./hub-core.js": "./hub-core.js",
    "./overlay.js": "./overlay.js",
    "./hub.json": "./hub.json",
    "./package.json": "./package.json",
    "./collector/vite.js": "./collector/vite.js",
    "./collector/plugin.js": "./collector/plugin.js",
    "./collector/config.js": "./collector/config.js",
    "./collector/stores.js": "./collector/stores.js"
  },
  "files": [
    "*.js",
    "*.html",
    "*.json",
    "icons",
    "collector",
    "cli",
    "mcp",
    "hub",
    "skill"
  ],
  "scripts": {
    "pack": "node pack.mjs",
    "pack:ci": "node pack.mjs --no-bump",
    "firefox-release": "node firefox-release.mjs"
  },
  "bin": {
    "review": "cli/review.mjs"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
